{
  "name": "eventmesh-client",
  "version": "1.0.0",
  "private": true,
  "description": "EventMesh ticketing and gate client terminals",
  "scripts": {
    "start": "react-scripts start",
    "start:ticketing": "REACT_APP_NODE_ROLE=LAPTOP_2_TICKETING react-scripts start",
    "start:gate": "REACT_APP_NODE_ROLE=LAPTOP_3_GATE_ANALYTICS react-scripts start",
